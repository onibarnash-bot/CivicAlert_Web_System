<%- include("partials/header", { title: "Community Reports" }) %>
<section class="page-intro"><span class="eyebrow">PUBLIC INCIDENT LIST</span><h1>Community reports</h1><p>Browse submitted reports and check their current review status.</p></section>
<form class="filter-bar" method="GET" action="/reports">
  <select name="category"><option value="">All categories</option><% categories.forEach(c => { %><option value="<%= c %>" <%= selected.category === c ? "selected" : "" %>><%= c %></option><% }) %></select>
  <select name="status"><option value="">All statuses</option><% statuses.forEach(s => { %><option value="<%= s %>" <%= selected.status === s ? "selected" : "" %>><%= s %></option><% }) %></select>
  <button class="btn primary" type="submit">Filter</button><a class="btn secondary" href="/reports">Reset</a>
</form>
<% if (reports.length) { %><div class="report-grid">
  <% reports.forEach(item => { %><article class="report-card">
    <div class="card-top"><span class="category"><%= item.category %></span><span class="status <%= item.status.toLowerCase() %>"><%= item.status %></span></div>
    <h3><%= item.location %></h3><p><%= item.description %></p>
    <% if (item.photoUrl) { %><a class="photo-link" href="<%= item.photoUrl %>" target="_blank" rel="noopener">View attached photo ↗</a><% } %>
    <div class="card-foot"><span>Reported by <%= item.reporterName %></span><span><%= new Date(item.createdAt).toLocaleString() %></span></div>
  </article><% }) %>
</div><% } else { %><div class="empty">No reports match your selected filters.</div><% } %>
<%- include("partials/footer") %>
