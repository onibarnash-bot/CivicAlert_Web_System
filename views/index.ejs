<%- include("partials/header", { title: "Home" }) %>
<section class="hero">
  <div class="hero-copy">
    <span class="eyebrow">COMMUNITY SAFETY • REAL-TIME AWARENESS</span>
    <h1>Report an incident.<br><em>Help your community.</em></h1>
    <p>CivicAlert gives citizens a simple way to report disaster incidents and helps the community stay informed.</p>
    <div class="hero-actions">
      <a class="btn primary" href="/report">＋ Submit a Report</a>
      <a class="btn secondary" href="/reports">View Community Reports</a>
    </div>
  </div>
  <div class="hero-art" aria-label="Community emergency awareness illustration">
    <div class="art-circle"></div><div class="art-card"><span class="art-icon">⚠</span><b>COMMUNITY ALERT</b><small>Stay aware. Stay prepared.</small><div class="art-line"></div><div class="art-line short"></div></div>
    <div class="art-pin">⌖</div>
  </div>
</section>
<section class="stats-grid">
  <div class="stat"><span>Total reports</span><strong><%= stats.total %></strong></div>
  <div class="stat"><span>Pending</span><strong><%= stats.pending %></strong></div>
  <div class="stat"><span>Verified</span><strong><%= stats.verified %></strong></div>
  <div class="stat"><span>Resolved</span><strong><%= stats.resolved %></strong></div>
</section>
<section class="section">
  <div class="section-heading"><div><span class="eyebrow">COMMUNITY UPDATES</span><h2>Recent incident reports</h2></div><a class="text-link" href="/reports">See all reports →</a></div>
  <% if (recent.length) { %><div class="report-grid">
    <% recent.forEach(item => { %><article class="report-card">
      <div class="card-top"><span class="category"><%= item.category %></span><span class="status <%= item.status.toLowerCase() %>"><%= item.status %></span></div>
      <h3><%= item.location %></h3><p><%= item.description %></p>
      <div class="card-foot"><span>Reported by <%= item.reporterName %></span><span><%= new Date(item.createdAt).toLocaleDateString() %></span></div>
    </article><% }) %>
  </div><% } else { %><div class="empty">No reports have been submitted yet. Be the first to help your community stay informed.</div><% } %>
</section>
<section class="notice"><div><span class="eyebrow">IMPORTANT REMINDER</span><h2>In an immediate emergency, contact local emergency services.</h2><p>CivicAlert is a community reporting tool and is not a replacement for emergency response services.</p></div><a class="btn light" href="/report">Report an Incident</a></section>
<%- include("partials/footer") %>
